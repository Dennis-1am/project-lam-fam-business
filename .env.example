# Base config (shared across dev/prod). Copy this to `.env` and fill in real values.
DATABASE_URL="file:./dev.db"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me-to-a-strong-password"
AUTH_SECRET="replace-with-a-long-random-string"
# Soft daily cap for translations in characters (Google free tier is ~16,000/day).
TRANSLATE_DAILY_LIMIT="16000"

# Google Cloud Translation API key. For local dev, set a real key in
# .env.development.local (gitignored) instead of this file, so a placeholder
# here is safe to commit.
# GOOGLE_CLOUD_TRANSLATE_API_KEY="replace-with-gcp-api-key"
# Comma-separated hosts allowed to load the dev server from other devices (e.g. your phone).
# Defaults to the Mac's LAN IP if unset.
ALLOWED_DEV_ORIGINS="10.0.0.76,192.168.1.5"