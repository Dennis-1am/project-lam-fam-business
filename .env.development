DATABASE_URL="file:./dev.db"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="dev"
AUTH_SECRET="dev-only-secret-not-used-in-production"
# Google Cloud Translation API key. Left as a placeholder by default so dev
# never spends the production project's free daily quota (16,000 chars).
# Set a real key in .env.development.local (gitignored) to test translations locally.
GOOGLE_CLOUD_TRANSLATE_API_KEY="replace-with-gcp-api-key"
# Comma-separated hosts allowed to load the dev server from other devices (e.g. your phone).
# Defaults to the Mac's LAN IP if unset.
ALLOWED_DEV_ORIGINS="10.0.0.76,192.168.1.5"