generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Product {
  id             String               @id @default(cuid())
  priceCents     Int                  @default(0)
  sourceLanguage String               @default("en")
  images         Image[]
  tagId          String?
  tag            Tag?                 @relation(fields: [tagId], references: [id], onDelete: SetNull)
  translations   ProductTranslation[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([createdAt])
  @@index([tagId])
}

model Tag {
  id        String    @id @default(cuid())
  name      String
  products  Product[]
  createdAt DateTime  @default(now())

  @@unique([name])
}

model Image {
  id         String   @id @default(cuid())
  url        String
  cropX      Float?
  cropY      Float?
  cropWidth  Float?
  cropHeight Float?
  position   Int      @default(0)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([productId])
}

model ProductTranslation {
  id                  String   @id @default(cuid())
  productId           String
  product             Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  language            String
  title               String   @default("")
  description         String   @default("")
  titleManual         Boolean  @default(false)
  descriptionManual   Boolean  @default(false)
  updatedAt           DateTime @updatedAt

  @@unique([productId, language])
  @@index([productId])
}

model TranslationQuota {
  id        Int      @id @default(1)
  date      String
  usedChars Int      @default(0)
  updatedAt DateTime @updatedAt
}