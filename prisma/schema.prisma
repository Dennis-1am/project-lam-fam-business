generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Product {
  id             String               @id @default(cuid())
  priceCents     Int                  @default(0)
  sourceLanguage String               @default("en")
  hidden         Boolean              @default(false)
  images         Image[]
  tagId          String?
  tag            Tag?                 @relation(fields: [tagId], references: [id], onDelete: SetNull)
  translations   ProductTranslation[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([createdAt])
  @@index([tagId])
}

model Tag {
  id        String    @id @default(cuid())
  name      String
  products  Product[]
  createdAt DateTime  @default(now())

  @@unique([name])
}

model Image {
  id          String   @id @default(cuid())
  url         String
  cropX       Float?
  cropY       Float?
  cropWidth   Float?
  cropHeight  Float?
  cropAspect  Float?
  imageWidth  Int?
  imageHeight Int?
  position    Int      @default(0)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([productId])
}

model ProductTranslation {
  id                  String   @id @default(cuid())
  productId           String
  product             Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  language            String
  title               String   @default("")
  description         String   @default("")
  titleManual         Boolean  @default(false)
  descriptionManual   Boolean  @default(false)
  updatedAt           DateTime @updatedAt

  @@unique([productId, language])
  @@index([productId])
}

model TranslationQuota {
  id        Int      @id @default(1)
  date      String
  usedChars Int      @default(0)
  updatedAt DateTime @updatedAt
}

// Singleton row (id is always 1) holding the admin-editable homepage banner.
// The crop columns intentionally mirror `Image`: the original upload is kept
// untouched and the crop is applied at render time, so the admin can re-crop
// later without re-uploading. That also makes this row usable as-is wherever a
// `CroppableImage` is expected.
model SiteBanner {
  id             Int                   @id @default(1)
  imageUrl       String?
  cropX          Float?
  cropY          Float?
  cropWidth      Float?
  cropHeight     Float?
  cropAspect     Float?
  imageWidth     Int?
  imageHeight    Int?
  sourceLanguage String                @default("en")
  translations   SiteBannerTranslation[]
  updatedAt      DateTime              @updatedAt
}

model SiteBannerTranslation {
  id         String     @id @default(cuid())
  bannerId   Int
  banner     SiteBanner  @relation(fields: [bannerId], references: [id], onDelete: Cascade)
  language   String
  text       String     @default("")
  textManual Boolean    @default(false)
  updatedAt  DateTime   @updatedAt

  @@unique([bannerId, language])
  @@index([bannerId])
}
